rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Path variable validation and private sync group validation
    match /users/{userId}/scroll_states/{urlHash} {
      allow read: if isValidId(userId) && userId == "my_shared_private_sync_id";

      allow create, update: if isValidId(userId) 
        && userId == "my_shared_private_sync_id"
        && isValidId(urlHash)
        && isValidScrollState(request.resource.data);

      allow delete: if isValidId(userId) && userId == "my_shared_private_sync_id";
    }
  }

  function isValidId(id) {
    return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
  }

  function isValidScrollState(data) {
    return data.keys().hasAll(['url', 'percent', 'updatedAt'])
      && data.keys().size() == 3
      && data.url is string
      && data.url.size() <= 2048
      && data.percent is number
      && data.percent >= 0.0
      && data.percent <= 1.0;
  }
}
