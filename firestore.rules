rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Path variable validation and private sync group validation
    match /users/{userId}/scroll_states/{urlHash} {
      allow read, delete: if isValidId(userId) && isValidId(urlHash);
      allow write: if isValidId(userId) && isValidId(urlHash) && isValidScrollState(request.resource.data);
    }
  }

  function isValidId(id) {
    return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
  }

  function isValidScrollState(data) {
    return data.keys().hasAll(['ciphertext', 'iv', 'updatedAt'])
      && data.keys().size() == 3
      && data.ciphertext is string
      && data.ciphertext.size() <= 8192
      && data.iv is string
      && data.iv.size() <= 128
      && data.updatedAt is string;
  }
}
